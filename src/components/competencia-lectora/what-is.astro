---
import Link from "@/components/ui/link.astro";
import pdfDemo from "@/assets/pdf/demo-reporte.pdf"
// --- DATOS EXTRAÍDOS DEL PDF DE PRESENTACIÓN ---

// Metodología Pedagógica: Conecta el aprendizaje con la realidad.
const metodologia = [
  {
    icon: '🌐',
    title: 'Lecturas Contextualizadas',
    description: 'Usamos situaciones del mundo real como problemas sociales, experimentos científicos y gráficos matemáticos para un aprendizaje significativo.'
  },
  {
    icon: '🧠',
    title: 'Preguntas Desafiantes',
    description: 'Fomentamos la interpretación y el pensamiento crítico con preguntas abiertas y de selección múltiple que van más allá de la simple comprensión.'
  },
];

// Currículo Flexible: 12 áreas para una integración total en su proyecto educativo.
const areasDisponibles = [
  'Química', 'Física', 'Biología', 'Matemáticas', 'Ciencias Sociales',
  'Ética y valores', 'Economía', 'Lengua Castellana', 'Ambiental', 'Inglés',
  'Administración', 'Emprendimiento',
];

// Beneficios Clave: Una inversión en el futuro de sus estudiantes.
const beneficios = [
  {
    icon: '🚀',
    title: 'Mejores Resultados en Pruebas Saber',
    description: 'Preparamos a los estudiantes para enfrentar con éxito las pruebas estandarizadas (ICFES), fortaleciendo los resultados institucionales.'
  },
  {
    icon: '💡',
    title: 'Desarrollo del Pensamiento Crítico',
    description: 'Transformamos a los estudiantes en ciudadanos reflexivos, capaces de analizar, argumentar y resolver problemas complejos del mundo real.'
  },
  {
    icon: '🧑‍🎓',
    title: 'Autonomía y Aprendizaje Integral',
    description: 'Fomentamos la autonomía en el aprendizaje y abrimos nuevas oportunidades académicas y profesionales para sus egresados.'
  },
];

// Oferta de Valor: Una solución completa para el año lectivo.
const oferta = {
  precioCOP: '70.000',
  incluye: [
    '1 libro impreso con registro ISBN, adaptable a su plan de estu.',
    '1 simulacro virtual tipo ICFES para medir y potenciar el prog.'
  ],
  detallesSimulacro: [
    'Alineado con los componentes de las pruebas Saber 3°, 5°, 9°, 10° y 11°.',
    'Programado por la institución con 15 días de antelación para su comodidad.',
    'Entrega de resultados detallados.'
  ]
};

// Metas para JSON-LD
const canonical = new URL("/competencia-lectora", Astro.site).toString();
const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Texto de Competencia Lectora + simulacro virtual",
  description: "Lecturas contextualizadas, preguntas desafiantes y simulacro tipo ICFES para fortalecer resultados institucionales.",
  brand: { "@type": "Brand", name: "Editorial EMHM" },
  url: canonical,
  // image: [new URL("/images/portada-competencia-lectora.png", Astro.site).toString()],
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
    url: canonical
  }
};
---

<section
  id="competencia-lectora-ventas"
  aria-label="Texto de Competencia Lectora"
  class="py-5 sm:py-24"
>
  <script type="application/ld+json">{JSON.stringify(productLd)}</script>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold">
        Potencie el Futuro de sus Estudiantes con Nuestra 
        <span class="text-indigo-700 italic">Herramienta Pedagógica</span>
      </h2>
      <p class="mt-4 text-lg text-slate-700">
        La competencia lectora es la base del éxito académico y profesional. Nuestro texto es la herramienta definitiva para formar líderes autónomos y preparados.
      </p>
    </div>
    <details class="mt-6 rounded-lg border border-slate-200 bg-white p-4">
      <summary class="cursor-pointer font-medium text-slate-900">
        ¡Conozca más sobre el simulacro virtual incluido!
      </summary>
      <div class="mt-4">
        <ul class="list-disc space-y-2 pl-4 text-slate-600">
          {oferta.detallesSimulacro.map(detail => (
            <li>{detail}</li>
          ))}
        </ul>
        <div class="mt-6">
          <Link
            href="/contactanos"
            rel="noopener"
            style="indigo"
            size="sm"
            aria-label="Solicitar asesoría para Competencia Lectora"
          >
            Solicitar asesoría
          </Link>
        </div>
      </div>
    </details>
    <div class="mt-16">
      <h3 class="text-2xl font-bold text-center text-slate-900">Una Metodología Diseñada para el Éxito</h3>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {metodologia.map(item => (
          <div class="rounded-2xl border border-slate-200 p-6 shadow-sm">
            <div class="flex items-center gap-4">
              <span class="text-3xl">{item.icon}</span>
              <h4 class="text-xl font-semibold text-slate-900">{item.title}</h4>
            </div>
            <p class="mt-3 text-slate-600">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 text-center">
      <h3 class="text-2xl font-bold text-slate-900">Currículo Flexible: 12 Áreas para Integrar en su Proyecto Educativo. </h3>
      <h3 class="text-2xl font-bold text-slate-900">La institución puede seleccionar las áreas de trabajo</h3>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Nuestros textos se adaptan a su plan académico, con <strong>dos lecturas por período</strong> para un avance constante y medible.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {areasDisponibles.map(area => (
          <span class="rounded-full bg-amber-50 px-3 py-1 text-sm font-medium text-emerald-800">{area}</span>
        ))}
      </div>
    </div>

    <div class="mt-20 pb-6">
      <h3 class="text-2xl font-bold text-center text-slate-900">Invierta en Resultados Comprobables</h3>
      <div class="mt-10 grid gap-8 sm:grid-cols-1 lg:grid-cols-3">
        {beneficios.map(b => (
          <div class="text-center">
            <p class="text-4xl">{b.icon}</p>
            <h4 class="mt-4 text-lg font-semibold text-slate-900">{b.title}</h4>
            <p class="mt-1 text-slate-600">{b.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- <div class="mt-20">
      <div class="rounded-2xl bg-slate-50 p-8">
        <div class="grid items-center gap-8 md:grid-cols-2">
          <div>
            <h3 class="font-display text-2xl font-bold text-slate-900">Nuestra Oferta</h3>
            <ul role="list" class="mt-4 space-y-2">
              {oferta.incluye.map(item => (
                <li class="flex items-start gap-3">
                  <span class="mt-1">🎯</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-lg bg-white p-6 text-center shadow">
            <p class="text-sm font-medium text-indigo-400">Valor por estudiante</p>
            <p class="mt-1 text-4xl font-bold text-slate-900">
              ${oferta.precioCOP} <span class="text-2xl">COP</span>
            </p>
          </div>
        </div>
      </div>
    </div> -->
    <div class="mx-auto relative overflow-hidden bg-indigo-50 rounded-3xl shadow-2xl py-20 sm:py-10">
      <div class="text-center">
        <p class="font-semibold text-indigo-700">Valor Agregado Único</p>
        <h3 class="mt-4 mb-4 2xl lg:text-3xl xl:text-4xl font-bold">Simulacro Virtual Incluido</h3>
      </div>
      
      <ul role="list" class="mx-6 mt-6 space-y-4 text-slate-700">
        <li class="flex items-start gap-3">
          <span class="mt-1 lg:text-1xl xl:text-2xl">✔️</span>
          <p class="lg:text-1xl xl:text-2xl">
            Incluye 1 simulacro virtual que la institución agenda según su cronograma.
          </p>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 lg:text-1xl xl:text-2xl">✔️</span>
          <p class="lg:text-1xl xl:text-2xl">
            Resultados con un reporte detallado por estudiante y un informe consolidado para la institución.
          </p>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 lg:text-1xl xl:text-2xl">✔️</span>
          <p class="lg:text-1xl xl:text-2xl">
            Basado en los componentes y la estructura que evalúa el ICFES en las pruebas Saber.
          </p>
        </li>
      </ul>
      
      <div class="mt-8 text-center">
        <Link
          href={pdfDemo}
          download="informe-demo.pdf"
          style="indigo"
          class="rounded-md px-6 py-3 text-base shadow-md lg:text-1xl xl:text-2xl"
          aria-label="Descargar ejemplo de informe del simulacro"
        >
          Quiero ver un ejemplo de informe
        </Link>
      </div>
      <div class="mt-12 text-center text-sm text-slate-600">
        También te puede interesar: 
        <a class="underline ml-1" href="/pre-icfes">Pre-ICFES</a> ·
        <a class="underline ml-1" href="/seguimiento-academico">Seguimiento académico</a>
      </div>
    </div>
  </div>
</section>