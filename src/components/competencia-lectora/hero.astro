---
import { Picture } from "astro:assets";
import heroImage from "@/assets/images/portada-competencia-lectora.png";
import Link from "@/components/ui/link.astro";
import demoPdf from "@/assets/pdf/demo.pdf"
const sectionId = 'hero-competencia-lectora';
---

<main
  class="grid grid-cols-1 lg:grid-cols-2 place-items-center gap-8 pt-16 pb-5 md:pt-12 md:pb-5"
>
  <div class="py-6 overflow-visible" style="aspect-ratio: 2032 / 2160;">
    <Picture
      src={heroImage}
      alt="Portada del texto de competencia lectora, básica primaria, grado tercero."
      widths={[620, 930, 1240]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
      fetchpriority="high"
      class="block max-w-full h-auto"
    />
  </div>

  <div>
    <h1 
      class="text-5xl lg:text-6xl xl:text-7xl font-bold"
    >
      <span class="text-black">Competencia lectora,</span>
      <span class="text-indigo-700 italic">para un mundo</span>
      <span class="text-black">de información rápida.</span>
    </h1>
    <p class="text-lg mt-4 text-black max-w-xl mx-auto lg:mx-0">
      De la comprensión a la acción: tus estudiantes leerán, interpretarán y resolverán problemas del mundo real.
    </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <Link
          href={demoPdf}
          download="demo.pdf"
          class="flex gap-1 items-center justify-center"
          style="indigo"
          aria-label="Descargar demo en PDF de un capítulo de Competencia Lectora"
          rel="noopener">
          <div class="flex items-center gap-2">
            <svg aria-hidden="true" viewBox="0 0 16 16" class="h-5 w-5 fill-current">
              <path d="M1.5 2A1.5 1.5 0 0 1 3 0.5h8A1.5 1.5 0 0 1 12.5 2v11.5c0 .276-.224.5-.5.5H3a2.5 2.5 0 0 0-1.5.5V2zM3 1.5A.5.5 0 0 0 2.5 2v11.086A3.49 3.49 0 0 1 3 13.5h8V2a.5.5 0 0 0-.5-.5H3z"/>
            </svg>
            <span class="material-symbols-outlined">
            book
            </span>
            <span class="text-sm">Solicita un demo de un capítulo</span>
          </div>
        </Link>
      </div>
      <div class="mt-2 flex flex-col sm:flex-row gap-3 items-start">
        <p class="italic text-zinc-500">Incluye libro impreso + simulacro virtual.</p>
        <a href="/libros/competencia-lectora" class="underline text-sm ml-0 sm:ml-2">Ver libros por grado</a>
      </div>

  </div>
</main>