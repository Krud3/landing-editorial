---
import Layout from "@/layouts/Layout.astro"
import Container from "@/components/container.astro"
import Seguimiento from "@/components/seguimiento-academico/seguimiento.astro"

const title = "Seguimiento Académico – diagnóstico, competencias y simulacros | Editorial EMHM";
const description = "Sistema integral de seguimiento: evaluación diagnóstica, evaluación por competencias y simulacros tipo Saber para mejorar resultados institucionales.";
const canonical = new URL("/seguimiento-academico", Astro.site).toString();

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type":"ListItem", position:1, name:"Inicio", item: new URL("/", Astro.site).toString() },
    { "@type":"ListItem", position:2, name:"Seguimiento Académico", item: canonical }
  ]
};

const webPageLd = {
  "@context":"https://schema.org",
  "@type":"WebPage",
  name: title,
  url: canonical,
  description
};
---


<Layout title={title} content={description} canonical={canonical}>
  <script type="application/ld+json">{JSON.stringify(breadcrumbLd)}</script>
  <script type="application/ld+json">{JSON.stringify(webPageLd)}</script>
  <Container>
    <Seguimiento/>
  </Container>
</Layout>

