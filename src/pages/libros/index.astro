---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/container.astro';
import Hero  from "@/components/libros/hero.astro" 
import Features from '@/components/libros/features.astro';

const asignaturas = await getCollection('asignaturas');
const title = "Libros por asignatura - Editorial EMHM";
const description = "Explora nuestras colecciones de libros por áreas de formación: castellano, matemáticas, ciencias, sociales y más.";
const canonical = new URL('/libros', Astro.site).toString();
---

<Layout title={title} content={description} canonical={canonical}>
  <Container class="pt-16 pb-8 md:pt-12 md:pb-24">
    <Hero/>
    <hr class="my-8" />
    <Features/>
    <!-- Áreas de Formación -->
    <h2 class="mt-4 text-3xl lg:text-4xl xl:text-5xl font-bold text-slate-900 text-center py-8">
      <span class="text-black">Nuestras</span>
      <span class="text-indigo-700 italic">Áreas</span>
      de Formación
    </h2>

    <div class="flex flex-wrap justify-center gap-8">
      {asignaturas.map((asignatura: any) => (
        <a
          href={`/libros/${asignatura.slug}`}
          class="flex-none w-full sm:w-[calc(50%-2rem)] lg:w-[calc(33.333%-2rem)] max-w-sm
                bg-white rounded-lg shadow-md overflow-hidden transform transition-all
                duration-300 hover:scale-105 hover:shadow-xl"
        >
          <Image
            src={asignatura.data.coverImage}
            alt={`Portada de ${asignatura.data.title}`}
            width={800}
            height={600}
            format="webp"
            quality={80}
            class="w-full h-64 object-cover"
          />
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800">{asignatura.data.title}</h3>
          </div>
        </a>
      ))}
    </div>

  </Container>
</Layout>