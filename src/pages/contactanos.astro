---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/contact/contact-form.astro";

const title = "Contáctanos | Editorial Mercedes Herrera Mora";
const description = "Escríbenos para cotizaciones o demo: textos académicos, competencia lectora, plataforma y Pre-ICFES. Teléfono, correo y dirección en Cali.";
const canonical = new URL("/contactanos", Astro.site).toString();

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type":"ListItem", position:1, name:"Inicio", item:new URL("/", Astro.site).toString() },
    { "@type":"ListItem", position:2, name:"Contáctanos", item:canonical }
  ]
};

// Schema local (mejor que Organization para búsquedas locales)
const localBusinessLd = {
  "@context":"https://schema.org",
  "@type":"LocalBusiness",
  name:"Editorial Mercedes Herrera Mora S.A.S.",
  url: canonical,
  email:"editorialmercedesherreramora@gmail.com",
  telephone:["+57 3187267013","+57 3171367968","+57 3243238533"],
  address:{
    "@type":"PostalAddress",
    streetAddress:"Callejón Alférez Real No 05",
    addressLocality:"Cali",
    addressRegion:"Valle del Cauca",
    addressCountry:"CO"
  },
  geo:{ "@type":"GeoCoordinates", latitude: 3.34735287907247, longitude: -76.5273513865163 },
  sameAs:[
    // añade tus redes reales si aplican
    // "https://www.facebook.com/tu-pagina",
    // "https://www.instagram.com/tu-pagina"
  ]
};
---

<Layout title={title} content={description} canonical={canonical}>
  <script type="application/ld+json">{JSON.stringify(breadcrumbLd)}</script>
  <script type="application/ld+json">{JSON.stringify(localBusinessLd)}</script>

  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 md:text-4xl">¡Hablemos!</h1>
      <p class="mx-auto mt-3 max-w-2xl text-gray-600">
        Estamos listos para acompañarte con <strong>textos académicos</strong>,
        <strong>competencia lectora</strong>, <strong>plataforma digital</strong> y
        <strong>proyecto Pre-ICFES</strong>. Déjanos tus datos y te contactaremos muy pronto.
      </p>
    </div>

    <div class="grid items-start gap-8 md:grid-cols-2">
      <!-- Información de contacto -->
      <div class="space-y-5 rounded-2xl bg-gray-50 p-6">
        <h2 class="text-xl font-semibold text-gray-900">Datos de la Editorial</h2>
        <ul class="space-y-3 text-gray-700">
          <li>
            <span class="block text-sm text-gray-500">Correo</span>
            <a class="text-indigo-600 underline" href="mailto:comercial@editorialmercedesherrerasas.com" aria-label="Enviar correo a la editorial">comercial@editorialmercedesherrerasas.com</a>
          </li>
          <li>
            <span class="block text-sm text-gray-500">Teléfonos</span>
            <div class="space-y-1">
              <a href="tel:+573187267013" class="block hover:underline" aria-label="Llamar al 318 726 7013">318 726 7013</a>
              <a href="tel:+573171367968" class="block hover:underline" aria-label="Llamar al 317 136 7968">317 136 7968</a>
              <a href="tel:+573243238533" class="block hover:underline" aria-label="Llamar al 324 323 8533">324 323 8533</a>
            </div>
          </li>
          <li>
            <span class="block text-sm text-gray-500">Dirección</span>
            <p>Callejón Alférez Real No 05 – Cali, Valle del Cauca, Colombia</p>
            <a
              class="mt-1 inline-block text-indigo-600 underline"
              href="https://www.google.com/maps/search/?api=1&query=Callej%C3%B3n%20Alf%C3%A9rez%20Real%20No%2005%2C%20Cali%2C%20Valle%20del%20Cauca"
              target="_blank" rel="noopener nofollow"
              aria-label="Abrir ubicación en Google Maps"
            >Ver en Google Maps</a>
          </li>
        </ul>

        <div class="pt-3 text-sm text-gray-500">
          <p><strong>NIT:</strong> 900838854-5</p>
          <p><strong>Representante Legal:</strong> Luis Francisco Cornejo Quiñones</p>
        </div>
      </div>

      <!-- Formulario -->
      <div>
        <h2 class="sr-only">Formulario de contacto</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>
